<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TD_Morpion_MAUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:TD_Morpion_MAUI.ViewModels"
    xmlns:models="clr-namespace:TD_Morpion_MAUI.Models"
    x:DataType="viewmodels:MainPageViewModel"
    Title="TD Morpion MAUI">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label
                Text="Morpion - Humain vs Humain"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding JoueurCourantTexte}"
                FontSize="20"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding MessagePartie}"
                FontSize="18"
                HorizontalOptions="Center"
                TextColor="DarkGreen" />

            <CollectionView
                ItemsSource="{Binding Cellules}"
                SelectionMode="None"
                HorizontalOptions="Center">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Span="3" Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Cellule">
                        <Button
                            Text="{Binding TexteAffiche}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.JouerCommande}"
                            CommandParameter="{Binding .}"
                            WidthRequest="90"
                            HeightRequest="90"
                            Margin="5"
                            FontSize="30"
                            FontAttributes="Bold"
                            BackgroundColor="LightGray"
                            TextColor="Black" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button
                Text="Recommencer"
                Command="{Binding ReinitialiserCommande}"
                WidthRequest="180"
                HorizontalOptions="Center"
                FontSize="18" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>